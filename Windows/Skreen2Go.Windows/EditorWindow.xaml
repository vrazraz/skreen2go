<Window x:Class="Skreen2Go.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skreen2Go — Screenshot" Width="1100" Height="760"
        MinWidth="700" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="#171B22" Foreground="#F5F7FA"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock Text="Skreen2Go" FontWeight="SemiBold" FontSize="20"
                       VerticalAlignment="Center" Margin="0,0,22,0" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Arrow" Click="OnArrow" />
                <Button Content="Rectangle" Click="OnRectangle" />
                <Button Content="Text" Click="OnText" />
                <Button Content="Undo" Click="OnUndo" />
                <Button Content="Redo" Click="OnRedo" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Copy" Click="OnCopy" />
                <Button Content="Save" Click="OnSave" />
                <Button Content="Save as…" Click="OnSaveAs" />
                <Button Content="Cancel" Click="OnCancel" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#262D38" CornerRadius="8" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" HorizontalAlignment="Left"
                         VerticalAlignment="Top">
                    <Grid x:Name="ImageSurface">
                        <Image x:Name="ScreenshotImage" Stretch="Fill" IsHitTestVisible="False" />
                        <Canvas x:Name="DrawingCanvas" Background="Transparent"
                                MouseLeftButtonDown="OnCanvasMouseDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseLeftButtonUp="OnCanvasMouseUp" />
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0"
                   Foreground="#AAB9C9" Text="Arrow · drag to draw · Ctrl+C to copy · Ctrl+S to save" />
    </Grid>
</Window>
