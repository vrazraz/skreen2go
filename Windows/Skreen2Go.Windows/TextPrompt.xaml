<Window x:Class="Skreen2Go.Windows.TextPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TextPromptTitle}" Width="380" Height="160" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#202733" Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource TextPromptLabel}" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Grid.Row="1" FontSize="16" VerticalContentAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Cancel}" Width="80" Margin="0,12,8,0" Click="OnCancel" />
            <Button Content="{DynamicResource Add}" Width="80" Margin="0,12,0,0" IsDefault="True" Click="OnAdd" />
        </StackPanel>
    </Grid>
</Window>
