<Window x:Class="Skreen2Go.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="610" Height="690"
        MinWidth="540" WindowStartupLocation="CenterScreen"
        Background="#171B22" Foreground="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="TextElement.Foreground" Value="#F5F7FA" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,0,7" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource SettingsHeading}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="{DynamicResource SaveFolder}" />
                <DockPanel Margin="0,5,0,12">
                    <Button Content="{DynamicResource Browse}" DockPanel.Dock="Right" Click="OnBrowse" />
                    <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{DynamicResource ScreenshotFormat}" />
                <ComboBox x:Name="FormatBox" HorizontalAlignment="Left" />
                <TextBlock Text="{DynamicResource InterfaceLanguage}" />
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" />
                <Separator Margin="0,5,0,12" Background="#465264" />
                <TextBlock Text="{DynamicResource ScreenshotHotkey}" />
                <TextBox x:Name="CaptureHotkeyBox" IsReadOnly="True"
                         PreviewKeyDown="OnCaptureHotkey" Margin="0,5,0,12" />
                <TextBlock Text="{DynamicResource RecordingHotkey}" />
                <TextBox x:Name="RecordingHotkeyBox" IsReadOnly="True"
                         PreviewKeyDown="OnRecordingHotkey" Margin="0,5,0,12" />
                <CheckBox x:Name="StartWithWindowsBox" Content="{DynamicResource StartWithWindows}" />
                <Separator Margin="0,12,0,12" Background="#465264" />
                <TextBlock Text="{DynamicResource Recording}" FontSize="17" FontWeight="SemiBold" />
                <CheckBox x:Name="SystemAudioBox" Content="{DynamicResource RecordSystemAudio}" />
                <CheckBox x:Name="MicrophoneBox" Content="{DynamicResource RecordMicrophone}" />
                <CheckBox x:Name="CursorBox" Content="{DynamicResource ShowCursor}" />
                <CheckBox x:Name="ClicksBox" Content="{DynamicResource HighlightClicks}" />
                <Separator Margin="0,12,0,12" Background="#465264" />
                <TextBlock Text="{DynamicResource Annotations}" FontSize="17" FontWeight="SemiBold" />
                <Button x:Name="ColorButton" Content="{DynamicResource ChooseColor}"
                        HorizontalAlignment="Left" Click="OnColor" />
                <TextBlock Text="{DynamicResource LineWidth}" Margin="0,8,0,0" />
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Text="{DynamicResource TextSize}" Margin="0,8,0,0" />
                <Slider x:Name="TextSizeSlider" Minimum="8" Maximum="96"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Text="{DynamicResource BlurRadius}" Margin="0,8,0,0" />
                <Slider x:Name="BlurSlider" Minimum="1" Maximum="40"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ErrorText" Foreground="#FFFF8A8A"
                       VerticalAlignment="Center" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{DynamicResource Reset}" Click="OnReset" />
                <Button Content="{DynamicResource Cancel}" Click="OnCancel" />
                <Button Content="{DynamicResource Save}" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
