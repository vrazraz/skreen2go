<Window x:Class="Skreen2Go.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skreen2Go — Settings" Width="610" Height="690"
        MinWidth="540" WindowStartupLocation="CenterScreen"
        Background="#171B22" Foreground="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#303947" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#465264" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,5,0,12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,0,7" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Save folder" />
                <DockPanel Margin="0,5,0,12">
                    <Button Content="Browse…" DockPanel.Dock="Right" Click="OnBrowse" />
                    <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Screenshot format" />
                <ComboBox x:Name="FormatBox" HorizontalAlignment="Left" />
                <TextBlock Text="Interface language" />
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" />
                <Separator Margin="0,5,0,12" Background="#465264" />
                <TextBlock Text="Screenshot hotkey" />
                <TextBox x:Name="CaptureHotkeyBox" IsReadOnly="True"
                         PreviewKeyDown="OnCaptureHotkey" Margin="0,5,0,12" />
                <TextBlock Text="Recording hotkey" />
                <TextBox x:Name="RecordingHotkeyBox" IsReadOnly="True"
                         PreviewKeyDown="OnRecordingHotkey" Margin="0,5,0,12" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />
                <Separator Margin="0,12,0,12" Background="#465264" />
                <TextBlock Text="Recording" FontSize="17" FontWeight="SemiBold" />
                <CheckBox x:Name="SystemAudioBox" Content="Record system audio" />
                <CheckBox x:Name="MicrophoneBox" Content="Record microphone" />
                <CheckBox x:Name="CursorBox" Content="Show cursor" />
                <CheckBox x:Name="ClicksBox" Content="Highlight clicks" />
                <Separator Margin="0,12,0,12" Background="#465264" />
                <TextBlock Text="Annotations" FontSize="17" FontWeight="SemiBold" />
                <Button x:Name="ColorButton" Content="Choose annotation color…"
                        HorizontalAlignment="Left" Click="OnColor" />
                <TextBlock Text="Line width" Margin="0,8,0,0" />
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Text="Text size" Margin="0,8,0,0" />
                <Slider x:Name="TextSizeSlider" Minimum="8" Maximum="96"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock Text="Blur radius" Margin="0,8,0,0" />
                <Slider x:Name="BlurSlider" Minimum="1" Maximum="40"
                        TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ErrorText" Foreground="#FFFF8A8A"
                       VerticalAlignment="Center" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Reset" Click="OnReset" />
                <Button Content="Cancel" Click="OnCancel" />
                <Button Content="Save" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
